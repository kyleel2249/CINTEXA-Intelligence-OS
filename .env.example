# Configure secrets in Cloudflare Workers (wrangler secret put NAME); never expose them in client builds.
# For local Worker development copy this file to worker/.dev.vars (git-ignored).

# --- Secrets (Worker only) ---
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
# Bearer token for POST /api/eti/orders (that route remains hard-disabled and always answers 403 once authorised).
ETI_EXECUTION_TOKEN=
# Token sent as x-eti-ingestion-token to POST /api/eti/observations and POST /api/eti/outcomes/evaluate.
ETI_INGESTION_TOKEN=

# --- Plain variables (Worker) ---
ETI_LIVE_ENABLED=false
# Exact origin of the web app that may call the API, e.g. https://cintexa.example (default https://cintexa.com).
CORS_ORIGIN=
# Best-effort per-IP, per-isolate request cap for POST /api/eti/signals (default 30 per minute).
RATE_LIMIT_PER_MIN=30
